# DB 백엔드: sqlite (기본) 또는 firebase
DB_BACKEND=sqlite
DATABASE_PATH=/app/data/riskmesh.db

# 웹 서버
WEB_BIND_ADDR=0.0.0.0:3000

# Logging
RUST_LOG=info

# Firebase / Firestore (DB_BACKEND=firebase 시에만)
