{
  "name": "open-parametric-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stable": "VITE_PROGRAM_STAGE=stable vite",
    "dev:stage": "VITE_PROGRAM_STAGE=staging vite",
    "build": "tsc -b && vite build",
    "build:stable": "VITE_PROGRAM_STAGE=stable npm run build",
    "build:stage": "VITE_PROGRAM_STAGE=staging npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "sync-idl": "cp ../contract/target/idl/open_parametric.json src/lib/idl/open_parametric.json && echo 'IDL JSON synced. Remember: open_parametric.ts is hand-maintained — update seeds/discriminators manually if renamed.'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@solana/web3.js": "^1.98.0",
    "@switchboard-xyz/on-demand": "^3.9.0",
    "@tanstack/react-query": "5.62.0",
    "axios": "^1.7.0",
    "chart.js": "^4.4.0",
    "i18next": "^25.8.13",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.1.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tanstack/react-query-devtools": "5.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bn.js": "^5.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "gh-pages": "^6.3.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.4.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.1.0+sha512.5b7bc055cad63273dda27df1570a5d2eb4a9f03b35b394d3d55393c2a5560a17f5cef30944b11d6a48bcbcfc1c3a26d618aae77044774c529ba36cb771ad5b0f"
}
